# ============================================================
# Stitchd Feature Flag — Environment Variables
# Copy this file to .env and fill in values for local dev.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development                  # development | production
RUST_LOG=stitchd=debug,info          # tracing log filter

# --- Server ports ---
HTTP_PORT=8080                       # Admin REST API
GRPC_PORT=50051                      # SDK gRPC service

# --- PostgreSQL (config store) ---
POSTGRES_USER=stitchd
POSTGRES_PASSWORD=stitchd
POSTGRES_DB=stitchd
POSTGRES_PORT=5432
DATABASE_URL=postgres://stitchd:stitchd@localhost:5432/stitchd

# --- ClickHouse (events / experiments store) ---
CLICKHOUSE_USER=stitchd
CLICKHOUSE_PASSWORD=stitchd
CLICKHOUSE_DB=stitchd
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_URL=http://stitchd:stitchd@localhost:8123/stitchd

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRY_SECONDS=3600
# AES-256-GCM key for OIDC/SAML provider config encryption. Must be exactly 32 bytes, base64-encoded.
# Generate for production: python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
STITCHD_AUTH_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Super Admin (self-hosted bootstrap) ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=stitchd-server
