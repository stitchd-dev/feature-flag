# ─── Local development environment ───────────────────────────────────────────
# DBs run in Docker (localhost). All services run as native cargo processes.
# Usage: source .env.local  OR  direnv allow (if using direnv)

# ── Postgres ──────────────────────────────────────────────────────────────────
export STITCHD_DATABASE_URL="postgres://<user>:<password>@localhost:5432/stitchd"

# ── ClickHouse ────────────────────────────────────────────────────────────────
export STITCHD_CLICKHOUSE_URL="http://localhost:8123"
export STITCHD_CLICKHOUSE_DB="stitchd"
export STITCHD_CLICKHOUSE_USER="stitchd"
export STITCHD_CLICKHOUSE_PASSWORD="stitchd"

# ── ScyllaDB ──────────────────────────────────────────────────────────────────
export STITCHD_SCYLLA_URI="localhost:9042"
export STITCHD_SCYLLA_KEYSPACE="stitchd_segments"

# ── Auth service ──────────────────────────────────────────────────────────────
export STITCHD_AUTH_SERVICE_GRPC_PORT="50051"
export STITCHD_AUTH_SERVICE_METRICS_PORT="9091"
export STITCHD_JWT_SECRET="<your-jwt-secret>"
export STITCHD_SUPERADMIN_EMAIL="<your-email>"
export STITCHD_SUPERADMIN_PASSWORD="<your-password>"

# ── Flag service ──────────────────────────────────────────────────────────────
export STITCHD_FLAG_SERVICE_GRPC_PORT="50052"
export STITCHD_FLAG_SERVICE_METRICS_PORT="9052"
export STITCHD_ANALYTICS_SERVICE_ADDR="http://localhost:50054"

# ── Segmentation service ──────────────────────────────────────────────────────
export STITCHD_SEGMENTATION_SERVICE_GRPC_PORT="50053"

# ── Analytics service ─────────────────────────────────────────────────────────
export STITCHD_ANALYTICS_SERVICE_GRPC_PORT="50054"
export STITCHD_ANALYTICS_SERVICE_METRICS_PORT="9104"

# ── Experimentation service ───────────────────────────────────────────────────
export STITCHD_EXPERIMENTATION_SERVICE_GRPC_PORT="50055"

# ── Stats service ─────────────────────────────────────────────────────────────
export STITCHD_STATS_SERVICE_GRPC_PORT="50056"
export STITCHD_STATS_SERVICE_HTTP_PORT="9200"

# ── Gateway ───────────────────────────────────────────────────────────────────
export STITCHD_GATEWAY_HTTP_PORT="8080"
export STITCHD_GATEWAY_METRICS_PORT="9080"
export STITCHD_AUTH_SERVICE_ADDR="http://localhost:50051"
export STITCHD_FLAG_SERVICE_ADDR="http://localhost:50052"
export STITCHD_SEGMENTATION_SERVICE_ADDR="http://localhost:50053"
export STITCHD_EXPERIMENTATION_SERVICE_ADDR="http://localhost:50055"
export STITCHD_STATS_SERVICE_ADDR="http://localhost:50056"

# ── Logging ───────────────────────────────────────────────────────────────────
export RUST_LOG="info"
