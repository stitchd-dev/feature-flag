# ─── Local development environment ───────────────────────────────────────────
# DBs run in Docker (localhost). All services run as native cargo processes.
# Usage: source .env.local  OR  direnv allow (if using direnv)

# ── Postgres ──────────────────────────────────────────────────────────────────
export DATABASE_URL="postgres://<user>:<password>@localhost:5432/stitchd"

# ── ClickHouse ────────────────────────────────────────────────────────────────
export CLICKHOUSE_URL="http://localhost:8123"
export CLICKHOUSE_DB="stitchd"
export CLICKHOUSE_USER="stitchd"
export CLICKHOUSE_PASSWORD="stitchd"

# ── ScyllaDB ──────────────────────────────────────────────────────────────────
export SCYLLA_URI="localhost:9042"
export SCYLLA_KEYSPACE="stitchd"

# ── Auth service ──────────────────────────────────────────────────────────────
export AUTH_SERVICE_PORT="50051"
export JWT_SECRET="<your-jwt-secret>"
export SUPERADMIN_EMAIL="<your-email>"
export SUPERADMIN_PASSWORD="<your-password>"

# ── Flag service ──────────────────────────────────────────────────────────────
export FLAG_SERVICE_PORT="50052"
export FLAG_METRICS_PORT="9052"
export ANALYTICS_SERVICE_ADDR="http://localhost:50054"

# ── Segmentation service ──────────────────────────────────────────────────────
export SEGMENTATION_SERVICE_PORT="50053"

# ── Analytics service ─────────────────────────────────────────────────────────
export ANALYTICS_GRPC_PORT="50054"
export METRICS_PORT="9104"

# ── Experimentation service ───────────────────────────────────────────────────
export EXPERIMENTATION_SERVICE_PORT="50055"

# ── Stats service ─────────────────────────────────────────────────────────────
export STATS_SERVICE_PORT="50056"
export STATS_HTTP_PORT="9200"

# ── Gateway ───────────────────────────────────────────────────────────────────
export GATEWAY_PORT="8080"
export GATEWAY_METRICS_PORT="9080"
export AUTH_SERVICE_ADDR="http://localhost:50051"
export FLAG_SERVICE_ADDR="http://localhost:50052"
export SEGMENTATION_SERVICE_ADDR="http://localhost:50053"
export EXPERIMENTATION_SERVICE_ADDR="http://localhost:50055"
export STATS_SERVICE_ADDR="http://localhost:50056"

# ── Logging ───────────────────────────────────────────────────────────────────
export RUST_LOG="info"
