{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                u.id,\n                u.email,\n                u.display_name,\n                u.avatar_url,\n                u.password_hash,\n                u.token_secret,\n                u.totp_secret,\n                u.totp_enabled,\n                u.status,\n                u.created_at,\n                u.updated_at,\n                m.role AS org_role\n            FROM users u\n            JOIN org_memberships m ON u.id = m.user_id\n            WHERE m.org_id = $1\n            ORDER BY u.email\n            ",
