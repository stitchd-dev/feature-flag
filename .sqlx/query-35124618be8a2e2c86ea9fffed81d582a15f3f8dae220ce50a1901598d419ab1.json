  "query": "\n            SELECT\n                id             AS \"id: SegmentId\",\n                environment_id AS \"environment_id: EnvironmentId\",\n                key,\n                segment_type   AS \"segment_type: SegmentType\",\n                created_at,\n                updated_at,\n                deleted_at,\n                version\n            FROM segments\n            WHERE key = $1 AND environment_id = $2 AND deleted_at IS NULL\n            ",
