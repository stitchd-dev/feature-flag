{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                u.id,\n                u.email,\n                u.display_name,\n                u.avatar_url,\n                u.password_hash,\n                u.token_secret,\n                u.totp_secret,\n                u.totp_enabled,\n                u.status,\n                u.created_at,\n                u.updated_at\n            FROM users u\n            JOIN org_memberships om ON om.user_id = u.id\n            WHERE om.org_id = $1\n            ORDER BY u.created_at\n            ",
