  "query": "\n            UPDATE roles\n            SET name = $1, updated_at = NOW(), version = $2\n            WHERE id = $3 AND version = $4 AND deleted_at IS NULL\n            RETURNING\n                id         AS \"id: RoleId\",\n                project_id AS \"project_id: ProjectId\",\n                name,\n                created_at,\n                updated_at,\n                deleted_at,\n                version\n            ",
