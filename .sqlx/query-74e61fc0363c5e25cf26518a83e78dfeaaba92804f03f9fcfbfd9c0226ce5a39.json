  "db_name": "PostgreSQL",
  "query": "\n            UPDATE users\n            SET email = $1, updated_at = NOW(), version = $2\n            WHERE id = $3 AND version = $4 AND deleted_at IS NULL\n            RETURNING\n                id              AS \"id: UserId\",\n                email,\n                password_hash,\n                organisation_id AS \"organisation_id: OrganisationId\",\n                created_at,\n                updated_at,\n                deleted_at,\n                version\n            ",
