  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                user_id,\n                org_id,\n                token_hash,\n                device_hint,\n                issued_at,\n                expires_at,\n                revoked_at,\n                last_used_at\n            FROM refresh_tokens\n            WHERE user_id = $1\n              AND revoked_at IS NULL\n              AND expires_at > now()\n            ORDER BY issued_at DESC\n            ",
