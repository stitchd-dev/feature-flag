  "db_name": "PostgreSQL",
  "query": "\n            UPDATE organisations\n            SET name = $1, updated_at = NOW(), version = $2\n            WHERE id = $3 AND version = $4 AND deleted_at IS NULL AND is_system = false\n            RETURNING\n                id         AS \"id: OrganisationId\",\n                name,\n                created_at,\n                updated_at,\n                deleted_at,\n                version,\n                is_system\n            ",
