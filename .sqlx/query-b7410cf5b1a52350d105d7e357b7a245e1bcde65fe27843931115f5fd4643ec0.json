  "query": "\n            SELECT\n                id,\n                user_id,\n                org_id,\n                token_hash,\n                device_hint,\n                issued_at,\n                expires_at,\n                revoked_at,\n                last_used_at\n            FROM refresh_tokens\n            WHERE token_hash = $1\n              AND revoked_at IS NULL\n              AND expires_at > now()\n            ",
