  "query": "\n            SELECT\n                id             AS \"id: SegmentId\",\n                environment_id AS \"environment_id: EnvironmentId\",\n                key,\n                name,\n                description,\n                tags,\n                segment_type   AS \"segment_type: SegmentType\",\n                created_at,\n                updated_at,\n                deleted_at,\n                version\n            FROM segments\n            WHERE id = $1 AND deleted_at IS NULL\n            ",
