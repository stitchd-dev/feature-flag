  "query": "\n            UPDATE segments\n            SET key = $1, segment_type = $2, updated_at = NOW(), version = $3\n            WHERE id = $4 AND version = $5 AND deleted_at IS NULL\n            RETURNING\n                id             AS \"id: SegmentId\",\n                environment_id AS \"environment_id: EnvironmentId\",\n                key,\n                segment_type   AS \"segment_type: SegmentType\",\n                created_at,\n                updated_at,\n                deleted_at,\n                version\n            ",
