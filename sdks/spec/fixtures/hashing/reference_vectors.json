      "target_values": ["alice"],
      "concatenated_input": "checkout-flow00000000-0000-0000-0000-000000000001alice",
      "expected_u128_hash": "222181947253813895803534738316378551102",
      "expected_percent": 51.102,
      "expected_bucket": 511
    },
    {
