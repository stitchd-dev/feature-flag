{
  "description": "MurmurHash3 x64_128 reference vectors. Inputs are concatenated UTF-8 strings (NO separator). Output is u128. Bucket = floor((u128 mod 100000) / 1000 * 10) clamped to [0, 999]. Source: crates/stitchd-core/src/hashing.rs::calculate_allocation, murmur3 crate v0.5.2.",
  "algorithm": {
    "hash": "murmur3_x64_128(input_bytes, seed=0)",
    "reduction": "percent = (u128 mod 100000) / 1000.0; bucket = min(999, floor(percent * 10))"
  },
  "vectors": [
